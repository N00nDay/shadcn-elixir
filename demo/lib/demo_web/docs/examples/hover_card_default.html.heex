<.hover_card>
  <.hover_card_trigger>
    <.button variant="link">@shadcn</.button>
  </.hover_card_trigger>
  <.hover_card_content class="w-80">
    <div class="flex gap-4">
      <.avatar>
        <.avatar_image src="https://github.com/shadcn.png" alt="@shadcn" />
        <.avatar_fallback>CN</.avatar_fallback>
      </.avatar>
      <div class="space-y-1">
        <h4 class="text-sm font-semibold">@shadcn</h4>
        <p class="text-sm text-muted-foreground">
          Components you copy into your project and own.
        </p>
      </div>
    </div>
  </.hover_card_content>
</.hover_card>
