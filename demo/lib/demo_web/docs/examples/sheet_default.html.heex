<.sheet id="sheet-demo">
  <.sheet_trigger dialog="sheet-demo">
    <.button variant="outline">Open Sheet</.button>
  </.sheet_trigger>
  <.sheet_content dialog="sheet-demo" side="right">
    <.sheet_header>
      <.sheet_title dialog="sheet-demo">Edit profile</.sheet_title>
      <.sheet_description dialog="sheet-demo">
        Make changes to your profile here. Click save when you're done.
      </.sheet_description>
    </.sheet_header>
  </.sheet_content>
</.sheet>
