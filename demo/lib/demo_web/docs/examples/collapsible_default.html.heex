<.collapsible class="w-full max-w-sm">
  <.collapsible_trigger class="flex w-full items-center justify-between rounded-md border px-4 py-2 text-sm font-medium select-none">
    Can I use this in production?
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </.collapsible_trigger>
  <.collapsible_content class="mt-2 rounded-md border px-4 py-2 text-sm text-muted-foreground">
