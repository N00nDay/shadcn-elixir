<div class="h-full w-full overflow-hidden">
  <.sidebar_provider id="sidebar-01-sb" class="h-full min-h-0">
    <.sidebar collapsible="offcanvas" class="h-full border-r">
      <.sidebar_header>
        <form class="px-1 py-1.5">
          <div class="relative">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-muted-foreground pointer-events-none absolute top-1/2 left-2 size-4 -translate-y-1/2 opacity-50"
            >
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
            <.input placeholder="Search the docs..." class="h-8 pl-8" />
          </div>
        </form>
      </.sidebar_header>
      <.sidebar_content>
        <.sidebar_group>
          <.sidebar_group_label>Getting Started</.sidebar_group_label>
          <.sidebar_group_content>
            <.sidebar_menu>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#" active>
                  <span>Installation</span>
                </.sidebar_menu_button>
              </.sidebar_menu_item>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#">
                  <span>Project Structure</span>
                </.sidebar_menu_button>
              </.sidebar_menu_item>
            </.sidebar_menu>
          </.sidebar_group_content>
        </.sidebar_group>
        <.sidebar_group>
          <.sidebar_group_label>Building Your Application</.sidebar_group_label>
          <.sidebar_group_content>
            <.sidebar_menu>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#"><span>Routing</span></.sidebar_menu_button>
              </.sidebar_menu_item>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#"><span>Data Fetching</span></.sidebar_menu_button>
              </.sidebar_menu_item>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#"><span>Rendering</span></.sidebar_menu_button>
              </.sidebar_menu_item>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#"><span>Caching</span></.sidebar_menu_button>
              </.sidebar_menu_item>
            </.sidebar_menu>
          </.sidebar_group_content>
        </.sidebar_group>
        <.sidebar_group>
          <.sidebar_group_label>API Reference</.sidebar_group_label>
          <.sidebar_group_content>
            <.sidebar_menu>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#"><span>Components</span></.sidebar_menu_button>
              </.sidebar_menu_item>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#">
                  <span>File Conventions</span>
                </.sidebar_menu_button>
              </.sidebar_menu_item>
            </.sidebar_menu>
          </.sidebar_group_content>
        </.sidebar_group>
      </.sidebar_content>
    </.sidebar>
    <.sidebar_inset class="min-h-0">
      <header class="flex h-12 shrink-0 items-center gap-2 border-b px-4">
        <.sidebar_trigger target="sidebar-01-sb" />
        <.separator orientation="vertical" class="mr-2 h-4" />
        <span class="text-sm text-muted-foreground">Building Your Application</span>
        <span class="text-sm text-muted-foreground">/</span>
        <span class="text-sm font-medium">Data Fetching</span>
      </header>
      <div class="flex flex-1 flex-col gap-4 overflow-auto p-4">
        <div class="grid auto-rows-min gap-4 md:grid-cols-3">
          <div class="bg-muted/50 aspect-video rounded-xl"></div>
          <div class="bg-muted/50 aspect-video rounded-xl"></div>
          <div class="bg-muted/50 aspect-video rounded-xl"></div>
        </div>
        <div class="bg-muted/50 min-h-[40vh] flex-1 rounded-xl"></div>
      </div>
    </.sidebar_inset>
  </.sidebar_provider>
</div>
