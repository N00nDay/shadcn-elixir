<div class="grid h-full lg:grid-cols-2">
  <div class="flex flex-col gap-4 p-6 md:p-10">
    <div class="flex justify-center gap-2 md:justify-start">
      <a href="#" class="flex items-center gap-2 font-medium">
        <div class="bg-primary text-primary-foreground flex size-6 items-center justify-center rounded-md">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M12 4v16" /><path d="M4 7c0-1.7 1.3-3 3-3h10c1.7 0 3 1.3 3 3" /><path d="M4 7v13" /><path d="M20 7v13" />
          </svg>
        </div>
        Acme Inc.
      </a>
    </div>
    <div class="flex flex-1 items-center justify-center">
      <div class="w-full max-w-xs">
        <form class="flex flex-col gap-6">
          <.field_group>
            <div class="flex flex-col items-center gap-1 text-center">
              <h1 class="text-2xl font-bold">Create your account</h1>
              <p class="text-muted-foreground text-sm text-balance">
                Fill in the form below to create your account
              </p>
            </div>
            <.field>
              <.field_label for="signup-02-name">Full Name</.field_label>
              <.input id="signup-02-name" type="text" placeholder="John Doe" required />
            </.field>
            <.field>
              <.field_label for="signup-02-email">Email</.field_label>
              <.input id="signup-02-email" type="email" placeholder="m@example.com" required />
              <.field_description>
                We'll use this to contact you. We will not share your email with anyone else.
              </.field_description>
            </.field>
            <.field>
              <.field_label for="signup-02-password">Password</.field_label>
              <.input id="signup-02-password" type="password" required />
              <.field_description>Must be at least 8 characters long.</.field_description>
            </.field>
            <.field>
              <.field_label for="signup-02-confirm">Confirm Password</.field_label>
              <.input id="signup-02-confirm" type="password" required />
              <.field_description>Please confirm your password.</.field_description>
            </.field>
            <.field>
              <.button type="submit">Create Account</.button>
            </.field>
            <.field_separator>Or continue with</.field_separator>
            <.field>
              <.button variant="outline" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                    fill="currentColor"
                  />
                </svg>
                Sign up with GitHub
              </.button>
              <.field_description class="px-6 text-center">
                Already have an account? <a href="#">Sign in</a>
              </.field_description>
            </.field>
          </.field_group>
        </form>
      </div>
    </div>
  </div>
  <div class="relative hidden lg:block">
    <.skeleton class="absolute inset-0 size-full rounded-none bg-muted/50" />
  </div>
</div>
