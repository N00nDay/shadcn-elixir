<div class="h-full w-full overflow-hidden">
  <.sidebar_provider id="sidebar-03-sb" class="h-full min-h-0">
    <.sidebar class="h-full border-r">
      <.sidebar_header>
        <div class="flex items-center gap-2 py-1.5">
          <div class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
            >
              <path d="M12 2 2 7l10 5 10-5-10-5Z" /><path d="m2 17 10 5 10-5" /><path d="m2 12 10 5 10-5" />
            </svg>
          </div>
          <div class="grid flex-1 text-left text-sm leading-tight group-data-[state=collapsed]/sidebar-wrapper:hidden">
            <span class="truncate font-semibold">Acme Inc</span>
            <span class="truncate text-xs text-muted-foreground">Enterprise</span>
          </div>
        </div>
      </.sidebar_header>
      <.sidebar_content>
        <.sidebar_group>
          <.sidebar_group_content>
            <.sidebar_menu>
              <.sidebar_menu_item id="mi-03-gs" data-state="open">
                <.sidebar_menu_button phx-click={
                  Phoenix.LiveView.JS.toggle_attribute({"data-state", "closed", "open"},
                    to: "#mi-03-gs"
                  )
                }>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m18 16 4-4-4-4" /><path d="m6 8-4 4 4 4" /><path d="m14.5 4-5 16" />
                  </svg>
                  <span>Getting Started</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="ml-auto transition-transform group-data-[state=open]/menu-item:rotate-180"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </.sidebar_menu_button>
                <.sidebar_menu_sub class="group-data-[state=closed]/menu-item:hidden">
                  <.sidebar_menu_sub_item>
                    <.sidebar_menu_sub_button href="#">
                      <span>Installation</span>
                    </.sidebar_menu_sub_button>
                  </.sidebar_menu_sub_item>
                  <.sidebar_menu_sub_item>
                    <.sidebar_menu_sub_button href="#">
                      <span>Project Structure</span>
                    </.sidebar_menu_sub_button>
                  </.sidebar_menu_sub_item>
                </.sidebar_menu_sub>
              </.sidebar_menu_item>
              <.sidebar_menu_item id="mi-03-app" data-state="open">
                <.sidebar_menu_button phx-click={
                  Phoenix.LiveView.JS.toggle_attribute({"data-state", "closed", "open"},
                    to: "#mi-03-app"
                  )
                }>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 8V4H8" /><rect width="16" height="12" x="4" y="8" rx="2" /><path d="M2 14h2" /><path d="M20 14h2" /><path d="M15 13v2" /><path d="M9 13v2" />
                  </svg>
                  <span>Building Your Application</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="ml-auto transition-transform group-data-[state=open]/menu-item:rotate-180"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </.sidebar_menu_button>
                <.sidebar_menu_sub class="group-data-[state=closed]/menu-item:hidden">
                  <.sidebar_menu_sub_item>
                    <.sidebar_menu_sub_button href="#">
                      <span>Routing</span>
                    </.sidebar_menu_sub_button>
                  </.sidebar_menu_sub_item>
                  <.sidebar_menu_sub_item>
                    <.sidebar_menu_sub_button href="#" active>
                      <span>Data Fetching</span>
                    </.sidebar_menu_sub_button>
                  </.sidebar_menu_sub_item>
                  <.sidebar_menu_sub_item>
                    <.sidebar_menu_sub_button href="#">
                      <span>Rendering</span>
                    </.sidebar_menu_sub_button>
                  </.sidebar_menu_sub_item>
                </.sidebar_menu_sub>
              </.sidebar_menu_item>
              <.sidebar_menu_item>
                <.sidebar_menu_button href="#">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                  <span>API Reference</span>
                </.sidebar_menu_button>
              </.sidebar_menu_item>
            </.sidebar_menu>
          </.sidebar_group_content>
        </.sidebar_group>
      </.sidebar_content>
    </.sidebar>
    <.sidebar_inset class="min-h-0">
      <header class="flex h-12 shrink-0 items-center gap-2 border-b px-4">
        <.sidebar_trigger target="sidebar-03-sb" />
        <.separator orientation="vertical" class="mr-2 h-4" />
        <span class="text-sm text-muted-foreground">Building Your Application</span>
        <span class="text-sm text-muted-foreground">/</span>
        <span class="text-sm font-medium">Data Fetching</span>
      </header>
      <div class="flex flex-1 flex-col gap-4 overflow-auto p-4">
        <div class="grid auto-rows-min gap-4 md:grid-cols-3">
          <div class="bg-muted/50 aspect-video rounded-xl"></div>
          <div class="bg-muted/50 aspect-video rounded-xl"></div>
          <div class="bg-muted/50 aspect-video rounded-xl"></div>
        </div>
        <div class="bg-muted/50 min-h-[40vh] flex-1 rounded-xl"></div>
      </div>
    </.sidebar_inset>
  </.sidebar_provider>
</div>
