<div class="flex h-full w-full items-center justify-center px-4">
  <.card class="mx-auto w-full max-w-sm">
    <.card_header>
      <.card_title class="text-2xl">Login</.card_title>
      <.card_description>Enter your email below to login to your account</.card_description>
    </.card_header>
    <.card_content>
      <form>
        <.field_group>
          <.field>
            <.field_label for="login-01-email">Email</.field_label>
            <.input id="login-01-email" type="email" placeholder="m@example.com" required />
          </.field>
          <.field>
            <div class="flex items-center">
              <.field_label for="login-01-password">Password</.field_label>
              <a href="#" class="ms-auto inline-block text-sm underline">
                Forgot your password?
              </a>
            </div>
            <.input id="login-01-password" type="password" required />
          </.field>
          <.field>
            <.button type="submit" class="w-full">Login</.button>
            <.button variant="outline" class="w-full">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"
                  fill="currentColor"
                />
              </svg>
              Login with Google
            </.button>
            <.field_description class="text-center">
              Don't have an account? <a href="#">Sign up</a>
            </.field_description>
          </.field>
        </.field_group>
      </form>
    </.card_content>
  </.card>
</div>
